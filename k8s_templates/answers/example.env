# Пример файла ответов для конструктора k8s_templates.
# Скопируйте в <target>.env (например prod.env), заполните значения и запустите:
#   ./scripts/build.sh --target <target>
#   ./scripts/deploy.sh --target <target>
# Либо сгенерируйте файл интерактивно: ./scripts/init-answers.sh --target <target>
#
# ВАЖНО: файлы answers/*.env (кроме example.env) исключены из git —
# здесь могут лежать секреты registry и пароли.

# --- Registry (раздельные учётки: PUSH=запись, PULL=только чтение) ---
REGISTRY="registry.summer-site.ru"
REGISTRY_IMAGE="dns-knot/dnsadmin"
REGISTRY_PUSH_USER="deployer"
REGISTRY_PUSH_PASSWORD=""
REGISTRY_PULL_USER="pelixm"
REGISTRY_PULL_PASSWORD=""
PULL_SECRET_NAME="registry-summersite"

# --- Namespace / PVC ---
NAMESPACE="dns-knot"
PVC_SIZE="2Gi"
PVC_STORAGE_CLASS="local-path"

# --- Кластер ---
CONTEXT="dns"
DNS_PRIMARY_NODE="first.cluster.summer-site.ru"
DNS_PRIMARY_IP="37.230.115.233"
DNS_PRIMARY_ID="first"
DNS_PRIMARY_IDENTITY="ns.summer-site.ru"
SECONDARY_NODES="master.cluster.summer-site.ru"
SECONDARY_IPS="77.106.252.16"
UI_NODE="master.cluster.summer-site.ru"

# --- Ingress UI ---
INGRESS_HOST="dnsadmin.summer-site.ru"
INGRESS_TLS="no"
INGRESS_CLASS="traefik"
INGRESS_ENTRYPOINT="web"

# --- Доступ к UI ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
JWT_SECRET=""

# --- DNS01 (cert-manager) ---
DNS01="no"
DNS01_MODE="rfc2136"
ACME_EMAIL=""
DNS01_NAMESERVER=""
WEBHOOK_GROUP_NAME="dnsadmin.knot.io"
WEBHOOK_VERSION="v1"

# --- Зоны ---
# ZONE_DIR="путь/к/своим/зонам"   # если не задан — берутся из components/<component>/zones
DEFAULT_ZONE="example.com"

# --- Прочее (опционально) ---
# KNOT_IMAGE="cznic/knot:3.4"
# AXFR_SECRET_NAME="knot-axfr"
# AXFR_KEY_ID="secondary-01"
# TSIG_SECRET=""                # если задан — используется как ключ secondary-01 (иначе генерируется)
