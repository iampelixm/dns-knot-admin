$ORIGIN example.com.
$TTL 3600
@ IN SOA ns.example.com. admin.example.com. (
  2026073001 ; serial
  3600 ; refresh
  600 ; retry
  1209600 ; expire
  3600 ; minimum
)
@ IN NS ns.example.com.
@ IN NS ns1.example.com.
@ IN NS ns2.example.com.
@ IN A 192.0.2.10
www IN A 192.0.2.10
ns IN A 192.0.2.11
ns1 IN A 192.0.2.12
ns2 IN A 192.0.2.13
